<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone dev tool — NOT part of the plugin build. Run it after a Nuclear Option update to
       catch reflection that silently broke (a field the game renamed / retyped). See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>apicheck</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>
</Project>
