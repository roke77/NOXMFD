<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone test project — NOT a ProjectReference to
       NOXMFD.csproj, which would drag in the $(GameDir)-relative Assembly-CSharp/
       UnityEngine.Modules/Mirage/Rewired references and require a real Nuclear Option install just
       to build tests. Instead compiles the specific pure .cs files directly (see the ItemGroup
       below), same standalone-sibling shape as tools/apicheck/. Excluded from the main plugin
       build already, via NOXMFD.csproj's blanket `<Compile Remove="tools\**\*.cs" />`. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both files are already 100% BCL — no Unity/BepInEx types — through the small storage/log/
         escape seam (RouteStore.ConfigDir/LogWarning/PersistToDisk fields, EscapeJson in
         JsonLite.cs). -->
    <Compile Include="..\..\src\plugin\JsonLite.cs" Link="Source\JsonLite.cs" />
    <Compile Include="..\..\src\plugin\Stores\RouteStore.cs" Link="Source\RouteStore.cs" />
    <!-- TdStore.cs (issue #47) — same pure-BCL shape as RouteStore.cs above; no Squad/Unit/
         CommandDispatcher touchpoint by design (see its own header comment). -->
    <Compile Include="..\..\src\plugin\Stores\TdStore.cs" Link="Source\TdStore.cs" />
    <!-- SquadTargetsStore.cs (issue #49) — same pure-BCL shape as TdStore.cs above; no Squad/Unit/
         CommandDispatcher touchpoint by design (see its own header comment). -->
    <Compile Include="..\..\src\plugin\Stores\SquadTargetsStore.cs" Link="Source\SquadTargetsStore.cs" />
    <!-- TelemetrySnapshot.cs is the plain DTO the frame is built from; TelemetryJson.cs is the
         pure serializer. Neither has a Unity/BepInEx touchpoint. -->
    <Compile Include="..\..\src\plugin\Telemetry\TelemetrySnapshot.cs" Link="Source\TelemetrySnapshot.cs" />
    <Compile Include="..\..\src\plugin\Telemetry\TelemetryJson.cs" Link="Source\TelemetryJson.cs" />
    <!-- TargetFocus.cs (issue #62) has no Unity/BepInEx touchpoint either — same pure-state shape
         as SoiFocus.cs, just never pulled in before since nothing there needed testing standalone. -->
    <Compile Include="..\..\src\plugin\Http\TargetFocus.cs" Link="Source\TargetFocus.cs" />
    <Compile Include="..\..\src\plugin\Http\CommandContentType.cs" Link="Source\CommandContentType.cs" />
    <Compile Include="..\..\src\plugin\TargetSelectionPolicy.cs" Link="Source\TargetSelectionPolicy.cs" />
    <Compile Include="..\..\src\plugin\Akf\AkfTrackerLogic.cs" Link="Source\AkfTrackerLogic.cs" />
    <Compile Include="..\..\src\plugin\Input\KeybindTapHold.cs" Link="Source\KeybindTapHold.cs" />
    <!-- ConfigBackup.cs (post-0.36.1) — pure System.IO, no Unity/BepInEx touchpoint. -->
    <Compile Include="..\..\src\plugin\ConfigBackup.cs" Link="Source\ConfigBackup.cs" />
    <Compile Include="..\..\src\plugin\Input\WeaponSelectorLogic.cs" Link="Source\WeaponSelectorLogic.cs" />
    <Compile Include="..\..\src\plugin\Tgp\TgpManualAimMath.cs" Link="Source\TgpManualAimMath.cs" />
    <Compile Include="..\..\src\plugin\Tgp\TgpFeedSettings.cs" Link="Source\TgpFeedSettings.cs" />
    <Compile Include="..\..\src\plugin\Tgp\TgpFullScreenMath.cs" Link="Source\TgpFullScreenMath.cs" />
    <Compile Include="..\..\src\plugin\Hud\HudDirectionCueMath.cs" Link="Source\HudDirectionCueMath.cs" />
    <Compile Include="..\..\src\plugin\Hud\HudWaypointCueMath.cs" Link="Source\HudWaypointCueMath.cs" />
    <Compile Include="..\..\src\plugin\Hud\HudTtiMath.cs" Link="Source\HudTtiMath.cs" />
  </ItemGroup>

</Project>
